{
  "name": "mailharbor",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "description": "Self-hosted email, optional AI briefings, and reviewable mailbox organization",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test --test-concurrency=1 tests/*.mjs",
    "package": "python scripts/package.py"
  },
  "dependencies": {
    "@zone-eu/mailsplit": "5.4.16",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "html-to-text": "10.0.1",
    "imapflow": "2.0.0",
    "libbase64": "1.3.0",
    "libmime": "5.4.3",
    "libqp": "2.1.1",
    "mailparser": "3.9.28",
    "node-forge": "1.4.0",
    "nodemailer": "10.0.10",
    "openpgp": "6.3.1",
    "pdfjs-dist": "6.3.289",
    "sanitize-html": "2.17.7",
    "web-push": "3.6.7"
  },
  "license": "MIT"
}
